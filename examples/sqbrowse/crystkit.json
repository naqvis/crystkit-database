{
  "$schema": "./schemas/crystkit.schema.json",
  "package": {
    "name": "SQBrowse",
    "version": "1.0.0",
    "identifier": "dev.crystkit.sqbrowse"
  },
  "build": {
    "frontend_dist": "./frontend/dist",
    "dev_url": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "SQBrowse",
        "width": 1280,
        "height": 860,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "capabilities_manifest": "./capabilities.json"
    }
  },
  "bundle": {
    "icon": [],
    "targets": ["dmg", "deb", "appimage", "msi"],
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 CrystKit"
  },
  "plugins": {}
}
